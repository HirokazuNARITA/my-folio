# Phase 1 で必要な環境変数
# このファイルを .env.local にコピーし、値を設定してください
# .env.local は .gitignore に含まれており、Git にコミットされません

# Supabase（Phase 4 で DB 操作、Phase 2 で認証）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma（Supabase Postgres 接続）
# ローカル開発用：Direct connectionの接続文字列を使う
# Vercel本番用：Transactionモードの接続文字列を使う
DATABASE_URL=

# UploadThing（Phase 5 で画像アップロード）
# uploadthing.com の API Keys → SDK v7+ タブから取得
UPLOADTHING_TOKEN=

# Stripe（Phase 6 で決済）
# stripe.com の API Keys から取得（サンドボックスは pk_test_ / sk_test_）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# ローカル: http://localhost:3000 / 本番: Vercel のデプロイ URL
NEXT_PUBLIC_APP_URL=
# ローカル: stripe listen で取得した whsec_... / 本番: Stripe ダッシュボードのエンドポイント詳細から取得
STRIPE_WEBHOOK_SECRET=

# PostHog（Phase 7 で分析）
# posthog.com の 左サイドバーの「Settings」→「Project」→「General」 から取得（phc_ で始まる）
NEXT_PUBLIC_POSTHOG_KEY=
# US Cloud: https://us.i.posthog.com / EU Cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
